<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Soraluzeko Udala - Ayuntamiento de Soraluze</title>
    <style>
        /* أحدث معايير التصميم لعام 2026 - الهوية البصرية لإقليم الباسك */
        :root {
            --basque-green: #007A33;    /* الأخضر الباسكي الرسمي */
            --basque-red: #C60B1E;      /* الأحمر الدافئ للتنبيهات والأزرار */
            --dark-slate: #111827;      /* النصوص العميقة */
            --glass-bg: rgba(255, 255, 255, 0.85);
            --card-shadow: 0 10px 30px rgba(0, 122, 51, 0.08);
            --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #F4F7F5;
            color: var(--dark-slate);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* شريط التنقل الزجاجي الحديث - Glassmorphism Navbar */
        header {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
            position: sticky;
            top: 0;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 24px;
        }

        .logo h1 {
            color: var(--basque-green);
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }
        .logo span {
            font-size: 13px;
            color: #6B7280;
            display: block;
            font-weight: 500;
        }

        nav ul {
            display: flex;
            list-style: none;
            align-items: center;
            gap: 24px;
        }

        nav ul li a {
            text-decoration: none;
            color: var(--dark-slate);
            font-weight: 600;
            font-size: 15px;
            transition: var(--transition-smooth);
            position: relative;
        }

        nav ul li a::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--basque-green);
            transition: var(--transition-smooth);
        }

        nav ul li a:hover::after {
            width: 100%;
        }

        .lang-switch {
            background: var(--basque-green);
            color: white !important;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(0, 122, 51, 0.2);
        }

        /* قسم الـ Hero الجذاب والمستوحى من الطبيعة الباسكية */
        .hero {
            background: linear-gradient(135deg, rgba(0, 122, 51, 0.9), rgba(17, 24, 39, 0.85)), url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
            color: white;
            padding: 100px 24px 80px;
            text-align: center;
            border-radius: 0 0 40px 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .hero h2 {
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 36px;
            opacity: 0.9;
            font-weight: 400;
        }

        /* صندوق بحث ذكي وعصري */
        .search-box {
            max-width: 650px;
            margin: 0 auto;
            display: flex;
            background: white;
            padding: 6px;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .search-box input {
            flex: 1;
            padding: 12px 20px;
            border: none;
            outline: none;
            font-size: 16px;
            border-radius: 30px;
        }

        .search-box button {
            background-color: var(--basque-green);
            color: white;
            border: none;
            padding: 0 28px;
            border-radius: 24px;
            cursor: pointer;
            font-weight: 700;
            transition: var(--transition-smooth);
        }

        .search-box button:hover {
            background-color: #005F26;
            transform: scale(1.02);
        }

        /* قسم المعاملات الإلكترونية ببطاقات تفاعلية متطورة */
        .section-container {
            max-width: 1200px;
            margin: 70px auto;
            padding: 0 24px;
        }

        .section-title {
            color: var(--dark-slate);
            margin-bottom: 35px;
            font-size: 28px;
            font-weight: 800;
            position: relative;
            display: inline-block;
        }

        .section-title::before {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 50px;
            height: 4px;
            background: var(--basque-red);
            border-radius: 2px;
        }

        .grid-4 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 24px;
        }

        .card {
            background: white;
            padding: 32px 24px;
            border-radius: 20px;
            text-align: center;
            box-shadow: var(--card-shadow);
            transition: var(--transition-smooth);
            cursor: pointer;
            text-decoration: none;
            color: var(--dark-slate);
            border: 1px solid rgba(0, 122, 51, 0.03);
        }

        .card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 122, 51, 0.15);
            border-color: rgba(0, 122, 51, 0.2);
        }

        .card-icon {
            font-size: 42px;
            margin-bottom: 20px;
            display: inline-block;
            transition: var(--transition-smooth);
        }

        .card:hover .card-icon {
            transform: scale(1.15);
        }

        .card h3 {
            margin-bottom: 12px;
            color: var(--dark-slate);
            font-size: 19px;
            font-weight: 700;
        }

        .card p {
            color: #6B7280;
            font-size: 14px;
        }

        /* قسم الأخبار والأجندة المنقسم بشكل عصري */
        .content-split {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }

        .news-item {
            background: white;
            padding: 24px;
            border-radius: 20px;
            margin-bottom: 24px;
            box-shadow: var(--card-shadow);
            transition: var(--transition-smooth);
        }

        .news-item:hover {
            transform: translateX(5px);
        }

        .news-date {
            color: var(--basque-red);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .news-item h4 {
            color: var(--dark-slate);
            margin-bottom: 12px;
            font-size: 20px;
            font-weight: 700;
        }

        .news-item p {
            color: #4B5563;
            font-size: 15px;
        }

        .agenda-item {
            background: white;
            padding: 20px;
            border-left: 5px solid var(--basque-green);
            margin-bottom: 18px;
            border-radius: 0 16px 16px 0;
            box-shadow: var(--card-shadow);
            transition: var(--transition-smooth);
        }

        .agenda-item:hover {
            border-left-color: var(--basque-red);
        }

        .agenda-date {
            color: var(--basque-green);
            font-weight: 700;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .agenda-item h5 {
            font-size: 15px;
            font-weight: 700;
            color: var(--dark-slate);
        }

        /* ذيل الصفحة الاحترافي المتناسق */
        footer {
            background-color: var(--dark-slate);
            color: #E5E7EB;
            padding: 60px 24px;
            margin-top: 80px;
            border-radius: 40px 40px 0 0;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 30px;
        }

        .footer-info h3 {
            color: white;
            margin-bottom: 12px;
            font-size: 22px;
        }

        /* المساعد الذكي وصندوق الشكاوى التفاعلي فائق التطور */
        #chat-icon {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: linear-gradient(135deg, var(--basque-green), #005F26);
            color: white;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0, 122, 51, 0.3);
            z-index: 9999;
            transition: var(--transition-smooth);
        }

        #chat-icon:hover {
            transform: scale(1.1) rotate(10deg);
        }

        #chat-box {
            position: fixed;
            bottom: 100px;
            right: 24px;
            width: 340px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            display: none;
            flex-direction: column;
            z-index: 9999;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.5);
            transition: var(--transition-smooth);
        }

        .chat-header {
            background: var(--basque-green);
            color: white;
            padding: 20px;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-body {
            padding: 20px;
            max-height: 250px;
            overflow-y: auto;
            font-size: 14px;
            background: rgba(244, 247, 245, 0.5);
        }

        .bot-msg {
            background: white;
            padding: 12px 16px;
            border-radius: 16px 16px 16px 4px;
            margin-bottom: 12px;
            color: var(--dark-slate);
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            border: 1px solid rgba(0,0,0,0.03);
        }

        .user-msg {
            background: var(--basque-green);
            color: white;
            padding: 12px 16px;
            border-radius: 16px 16px 4px 16px;
            margin-bottom: 12px;
            text-align: right;
            align-self: flex-end;
            margin-left: 40px;
        }

        .chat-footer {
            padding: 16px;
            border-top: 1px solid rgba(0,0,0,0.05);
            display: flex;
            gap: 8px;
            background: white;
        }

        .chat-btn {
            background: #F3F4F6;
            color: var(--dark-slate);
            border: none;
            padding: 8px 14px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition-smooth);
            flex: 1;
        }

        .chat-btn:hover {
            background: var(--basque-green);
            color: white;
        }

        .chat-btn.danger:hover {
            background: var(--basque-red);
        }

        /* تحسينات الهواتف الذكية الاستثنائية - Mobile Responsive */
        @media (max-width: 768px) {
            .nav-container {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }
            nav ul {
                gap: 16px;
            }
            .hero h2 {
                font-size: 28px;
            }
            .content-split {
                grid-template-columns: 1fr;
            }
            #chat-box {
                width: calc(100% - 48px);
                right: 24px;
                left: 24px;
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <div class="logo">
                <h1>Soraluzeko Udala</h1>
                <span>Ayuntamiento de Soraluze</span>
            </div>
            <nav>
                <ul>
                    <li><a href="#">Ayuntamiento</a></li>
                    <li><a href="#">Trámites</a></li>
                    <li><a href="#">Noticias</a></li>
                    <li><a href="#">Agenda</a></li>
                    <li><a href="#" class="lang-switch">EU</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="hero">
        <h2>Ongi etorri Soraluzeko Udalera</h2>
        <p>Bienvenidos al portal oficial del Ayuntamiento de Soraluze - Guipúzcoa</p>
        <div class="search-box">
            <input type="text" placeholder="¿Qué servicio o trámite necesitas hoy?">
            <button>Buscar</button>
        </div>
    </section>

    <section class="section-container">
        <h3 class="section-title">Trámites Destacados</h3>
        <div class="grid-4">
            <div class="card">
                <div class="card-icon">📝</div>
                <h3>Registro de entrada</h3>
                <p>Presentación oficial de documentos y solicitudes telemáticas.</p>
            </div>
            <div class="card">
                <div class="card-icon">📋</div>
                <h3>Padrón municipal</h3>
                <p>Altas, modificaciones y obtención inmediata de volantes oficiales.</p>
            </div>
            <div class="card">
                <div class="card-icon">🖊️</div>
                <h3>Inscripciones</h3>
                <p>Cursos de formation, actividades deportivas y ofertas de empleo.</p>
            </div>
            <div class="card">
                <div class="card-icon">🎟️</div>
                <h3>Venta de entradas</h3>
                <p>Reserva tus pases para el teatro, cine y eventos culturales locales.</p>
            </div>
        </div>
    </section>

    <div class="section-container content-split">
        <section>
            <h3 class="section-title">Últimas Noticias</h3>
            
            <div class="news-item">
                <div class="news-date">02/06/2026</div>
                <h4>Sesión plenaria de la Corporación Municipal este miércoles, 3 de junio</h4>
                <p>Convocatoria pública a la ciudadanía para asistir al pleno ordinario mensual que tratará los presupuestos participativos de este año.</p>
            </div>

            <div class="news-item">
                <div class="news-date">01/06/2026</div>
                <h4>Exposición de los Rallys Fotográficos de Kontrargi (1989 - 2008)</h4>
                <p>Se abre oficialmente la retrospectiva histórica en la Sala de Exposiciones de la Casa de Cultura. Entrada libre hasta completar aforo.</p>
            </div>
        </section>

        <section>
            <h3 class="section-title">Agenda Cultural</h3>
            
            <div class="agenda-item">
                <div class="agenda-date">Hasta el 30 de Junio</div>
                <h5>Exposición: Jone Telleria "Airean"</h5>
            </div>

            <div class="agenda-item">
                <div class="agenda-date">31 Mayo - 10 Junio</div>
                <h5>Inscripción Haurreskola: Aula de Julio</h5>
            </div>
        </section>
    </div>

    <footer>
        <div class="footer-container">
            <div class="footer-info">
                <h3>SORALUZEKO UDALA</h3>
                <p>Plaza Santa Ana, 1. Soraluze (Gipuzkoa) 20590</p>
                <p>Tlf: 943 753043 | Email: udala@soraluze.eus</p>
            </div>
            <div>
                <p>&copy; 2026 Soraluze Udala. Diseño Premium Web 4.0</p>
            </div>
        </div>
    </footer>

    <div id="chat-icon" onclick="toggleChat()">💬</div>

    <div id="chat-box">
        <div class="chat-header">
            <span>UdalBot - Soraluze</span>
            <span style="cursor: pointer; font-size: 20px;" onclick="toggleChat()">✕</span>
        </div>
        <div class="chat-body" id="chat-content">
            <div class="bot-msg">Kaixo! Soy tu asistente virtual de Soraluze. ¿En qué puedo guiarte hoy?</div>
        </div>
        <div class="chat-footer">
            <button class="chat-btn" onclick="askBot('padrón')">📄 Padrón</button>
            <button class="chat-btn danger" onclick="askBot('queja')">⚠️ Quejas</button>
        </div>
    </div>

    <script>
        function toggleChat() {
            var chat = document.getElementById('chat-box');
            chat.style.display = (chat.style.display === 'none' || chat.style.display === '') ? 'flex' : 'none';
        }

        function askBot(topic) {
            var content = document.getElementById('chat-content');
            if(topic === 'padrón') {
                content.innerHTML += "<div class='user-msg'>¿Cómo solicito el padrón?</div>";
                content.innerHTML += "<div class='bot-msg'>Para el <strong>Padrón Municipal</strong>, puedes solicitarlo online con tu certificado digital IZENPE en nuestra sección 'Trámites' o presencialmente en el Ayuntamiento aportando tu DNI y documento de vivienda.</div>";
            } else if(topic === 'queja') {
                content.innerHTML += "<div class='user-msg'>Quiero reportar una queja urbana</div>";
                content.innerHTML += "<div class='bot-msg'>Agradecemos tu ayuda. Puedes registrar una incidencia enviando una foto y la ubicación a <strong>udala@soraluze.eus</strong> o llamando al 943 753043.</div>";
            }
            content.scrollTop = content.scrollHeight;
        }
    </script>

</body>
</html>
